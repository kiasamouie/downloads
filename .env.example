# Output directories. Copy this file to .env and adjust the values for your machine.
# Values support ~ expansion. Real environment variables take precedence over .env.
#
# WSL example (files visible from Windows, drive C, user "YOURUSER"):
#   MUSIC_DIR=/mnt/c/Users/YOURUSER/Documents/Music
#   VIDEOS_DIR=/mnt/c/Users/YOURUSER/Videos

# Folder for audio downloads (default: ~/Music)
MUSIC_DIR=~/Music

# Folder for video downloads (default: ~/Videos)
VIDEOS_DIR=~/Videos
